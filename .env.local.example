# Supabase — https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # 절대 NEXT_PUBLIC_ 붙이지 말 것

# Google Maps — https://console.cloud.google.com/apis/credentials
# API key restrictions: HTTP referrer → 본인 Vercel 도메인만
# API restrictions: Maps JavaScript API + Places API 허용
#   장소 검색은 Maps JS 의 places 라이브러리에서 google.maps.places.Autocomplete 를 쓴다.
#   이 위젯은 legacy Places API 쪽이라 "Places API (New)" 만 켜면 자동완성이 뜨지 않는다.
#   (app/trip/add/AddPlaceView.tsx 의 TODO — PlaceAutocompleteElement 로 옮길 예정)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<maps-api-key>

# Google Maps Server Key — 서버에서만 사용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
# API restrictions: 아래 두 API 를 모두 허용해야 한다
#   - Routes API : directions/v2:computeRoutes (경로 polyline, app/api/route)
#                  distanceMatrix/v2:computeRouteMatrix (이동 시간, app/api/distance)
#   - Places API : maps.googleapis.com/maps/api/place/details/json
#                  maps.googleapis.com/maps/api/place/findplacefromtext/json
#                  → app/api/resolve-place, Google Takeout import 의 좌표 조회에 쓴다
# 주의: 위 place/details, findplacefromtext 는 Google 의 legacy Places API 다
#       (후속 API 는 Places API (New)). 새로 만든 Google Cloud 프로젝트라면
#       콘솔에서 legacy "Places API" 를 따로 활성화해야 한다.
#       Routes API 만 허용하면 Takeout import 의 좌표 조회가 조용히 실패한다.
GOOGLE_MAPS_SERVER_KEY=<server-maps-api-key>
